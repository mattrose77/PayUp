// Copy this file to Config/Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is gitignored so the key can be rotated without a commit.
//
// The publishable key is safe to ship in a client — row-level security is what
// protects the data — but it stays out of source control regardless.

// The "//" in https:// would start a comment, so the slashes are spliced back
// together in Config.swift. Store the URL without its scheme.
SUPABASE_HOST = your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_xxx
